rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && (request.auth.token.email == 'adsamanda02@gmail.com' || request.auth.token.email == 'aadestia@gmail.com'); }
    function isYCP() { return isSignedIn() && request.auth.token.email.matches('.*@ycp\\.com'); }
    function existing() { return resource.data; }
    function incoming() { return request.resource.data; }
    function isValidId(id) { return id is string; }

    function isValidAppItem(data) {
      return data.keys().hasAll(['name', 'description', 'version', 'date', 'category', 'downloadUrl'])
        && data.name is string && data.name.size() > 0;
    }

    match /apps/{appId} {
      allow read: if true;
      
      allow create: if isAdmin() 
        && isValidId(appId)
        && isValidAppItem(incoming());
        
      allow update: if isAdmin()
        && isValidId(appId)
        && isValidAppItem(incoming());
        
      allow delete: if isAdmin();
    }
  }
}
